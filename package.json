{
  "name": "agent-guild",
  "displayName": "Agent Guild: AI Coding Agents",
  "description": "Watch Claude Code, Codex CLI, Antigravity CLI, Grok Build and Docker Agent sessions come alive as characters in a 3D world, and open any one's real terminal with a double-click.",
  "version": "0.0.0",
  "publisher": "OddEssentials",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f2a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oddessentials/agent-guild-vscode.git"
  },
  "homepage": "https://github.com/oddessentials/agent-guild#readme",
  "bugs": {
    "url": "https://github.com/oddessentials/agent-guild-vscode/issues"
  },
  "qna": "https://github.com/oddessentials/agent-guild-vscode/issues",
  "sponsor": {
    "url": "https://oddessentials.ai/donate/?ref=agent-guild-vscode"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "ai agents",
    "coding agents",
    "agent",
    "agents",
    "multi-agent",
    "parallel agents",
    "agent manager",
    "agent dashboard",
    "claude",
    "claude code",
    "anthropic",
    "codex",
    "codex cli",
    "openai",
    "antigravity",
    "antigravity cli",
    "grok",
    "grok build",
    "docker agent",
    "terminal",
    "visualization",
    "3d",
    "agent visualization",
    "animated characters",
    "subagents",
    "three.js"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:agentGuild.page",
    "onView:agentGuild.yard"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "agentGuild.yard",
          "name": "Agent Guild",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "agentGuild.open",
        "title": "Open",
        "category": "Agent Guild"
      },
      {
        "command": "agentGuild.openYard",
        "title": "Open the Yard",
        "category": "Agent Guild"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:e2e": "node test/e2e/run.js",
    "package": "vsce package --out agent-guild.vsix"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0"
  }
}
