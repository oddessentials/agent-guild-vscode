{
  "name": "agent-guild",
  "displayName": "Agent Guild: AI Coding Agents",
  "description": "Run Claude Code, Codex CLI, Antigravity CLI, Grok Build and Docker Agent side by side in real terminals, from a VS Code tab.",
  "version": "0.0.0",
  "publisher": "OddEssentials",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f2a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oddessentials/agent-guild-vscode.git"
  },
  "homepage": "https://github.com/oddessentials/agent-guild#readme",
  "bugs": {
    "url": "https://github.com/oddessentials/agent-guild-vscode/issues"
  },
  "qna": "https://github.com/oddessentials/agent-guild-vscode/issues",
  "sponsor": {
    "url": "https://oddessentials.ai/donate/?ref=agent-guild-vscode"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI"
  ],
  "keywords": [
    "ai",
    "ai agents",
    "coding agents",
    "agent",
    "agents",
    "multi-agent",
    "parallel agents",
    "agent manager",
    "agent dashboard",
    "dashboard",
    "claude",
    "claude code",
    "anthropic",
    "codex",
    "codex cli",
    "openai",
    "antigravity",
    "antigravity cli",
    "grok",
    "grok build",
    "xai",
    "docker agent",
    "docker",
    "terminal",
    "tmux",
    "sessions",
    "session manager"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:agentGuild.page"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentGuild.open",
        "title": "Open",
        "category": "Agent Guild"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:e2e": "node test/e2e/run.js",
    "package": "vsce package --out agent-guild.vsix"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0"
  }
}
