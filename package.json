{
  "name": "agent-guild",
  "displayName": "Agent Guild",
  "description": "Launch and watch your AI coding-assistant sessions from an editor tab, with the same sessions your browser shows.",
  "version": "0.0.0",
  "publisher": "OddEssentials",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f2a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oddessentials/agent-guild-vscode.git"
  },
  "homepage": "https://github.com/oddessentials/agent-guild#readme",
  "bugs": {
    "url": "https://github.com/oddessentials/agent-guild-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agents",
    "claude code",
    "codex",
    "terminal",
    "sessions"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:agentGuild.page"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentGuild.open",
        "title": "Open",
        "category": "Agent Guild"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:e2e": "node test/e2e/run.js",
    "package": "vsce package --out agent-guild.vsix"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0"
  }
}
